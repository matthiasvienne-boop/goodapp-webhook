{
  "name": "@goodapp/webhook",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Webhook receiving for GoodApp products: Stripe-compatible signature check, fail-closed without a secret, and claim-plus-processing in one transaction.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthiasvienne-boop/goodapp-webhook.git"
  },
  "type": "commonjs",
  "exports": {
    "./server": {
      "types": "./dist/cjs/server/index.d.ts",
      "require": "./dist/cjs/server/index.js",
      "import": "./dist/esm/server/index.js"
    },
    "./testing": {
      "types": "./dist/cjs/server/testing.d.ts",
      "require": "./dist/cjs/server/testing.js",
      "import": "./dist/esm/server/testing.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/cjs/server/index.d.ts"
      ],
      "testing": [
        "dist/cjs/server/testing.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:pkgs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:pkgs": "node scripts/write-dist-package-json.js",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "express": "^4.18.2",
    "stripe": "^22.6.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
